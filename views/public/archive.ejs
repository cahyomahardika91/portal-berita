<div class="layout">
  <div class="content">
    <h1 class="section-title"><%= heading %></h1>
    <% if (sub) { %><p class="lead"><%= sub %></p><% } %>
    <div class="list">
      <% posts.forEach(p => { %><%- include('public/_card', { p, size: 'row' }) %><% }) %>
      <% if (!posts.length) { %><p>Tidak ada artikel ditemukan.</p><% } %>
    </div>
    <%- include('public/_pager') %>
  </div>
  <%- include('public/_sidebar') %>
</div>
