# Dependencies (Folder ini sangat besar dan diunduh otomatis via npm/yarn)
node_modules/
jspm_packages/
bower_components/

# Environment Variables (Berisi kredensial rahasia seperti API key dan password database)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
! .env.example

# Logs (File catatan aktivitas dan error)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data (Proses ID dan cache)
pids
*.pid
*.seed
*.pid.lock

# Folder Hasil Build / Output Kompilasi (Misal jika menggunakan TypeScript atau bundler)
dist/
build/
out/
.next/
.nuxt/

# Testing & Coverage (Hasil uji coba kode)
coverage/
.nyc_output/
*.lcov

# Cache Editor & Tooling
.eslintcache
.parcel-cache
.cache/
.tsbuildinfo
.node_repl_history

# Sistem Operasi (Mac & Windows)
.DS_Store
Thumbs.db